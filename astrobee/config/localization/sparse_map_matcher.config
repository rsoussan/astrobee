num_cv_threads = 1
-- Estimate Pose
reprojection_optimize_estimate = true
reprojection_max_num_iterations = 100
reprojection_function_tolerance = 1e-8
reprojection_parameter_tolerance = 1e-8
reprojection_verbose_optimization = false 
reprojection_huber_loss = 1.345
-- TODO(rsoussan): This was iterative schur in loc code but dense should be better for small problems, test!
reprojection_linear_solver = "dense_qr" 
reprojection_use_explicit_schur_complement = false 
reprojection_max_inlier_threshold = 5.0
-- RansacPnP params
ransac_max_inlier_threshold = 5.0
ransac_num_iterations = 100
ransac_min_num_inliers = 10 
-- p3p, epnp, ap3p, or it
ransac_pnp_method = "p3p"
-- Other
max_num_total_feature_matches = 100
check_point_3d_exists = true
max_image_matches = 20
-- Brisk Detector
threshold = 90.0 
octaves = 4 
float_pattern_scale = 1.0
-- Dynamic Detector
min_features = 200
max_features = 800
max_retries = 1
min_threshold = 20.0
-- This is overriden by the brisk threshold and thus ignored
-- TODO(rsoussan): Clean up
starting_threshold = 90.0
max_threshold = 110.0
center_keypoints = true
increase_threshold_multiplier = 1.25
decrease_threshold_multiplier = 0.8
